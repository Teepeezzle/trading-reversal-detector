//@version=6
// =====================================================================
// V5 CONFLUENCE + TWO-ZONE DRS GATE  [Study / Full History]
//
// Draws, on the chart, exactly what the live confluence scanner keys on, PLUS
// the two-zone finding from the 2y backtest:
//   * DRS support/resistance levels (the "red" stops): support = low-1.5*ATR20
//     on a DRS-long bar, resistance = high+1.5*ATR20 on a DRS-short bar.
//     Faithful to src/v5_confluence.py::drs_signals (EMA9/21 cross + 3-bar
//     extreme + volume spike + ATR-momentum bar).
//   * Aligned V5 MACD divergence (12/26/9, pivots 2/2, span 6-50, 200-SMA
//     aligned) = the trigger.
//   * TWO-ZONE GATE: at each aligned divergence, count how many DISTINCT
//     same-direction DRS levels (merged within 0.75*ATR14) sit near price
//     within the last 30 days. Backtest expectancy by count:
//         ◆   1 zone  -> +0.30R (35% win)   weak, near break-even
//         ◆◆  2 zones -> +1.20R (60% win)   the validated tier
//         ◆◆◆ 3+ zones-> +1.57R (70% win)   strongest
//
// HONEST SCOPE NOTE: the live scanner aggregates DRS zones across ALL 7
// timeframes; this indicator counts zones on the CHART timeframe (plus,
// optionally, ONE higher timeframe). So the on-chart tier APPROXIMATES the
// scanner's multi-TF count -- directional confirmation you can SEE, not a
// byte-exact replica of the email. Exits shown (SL 1.5*ATR / TP 4*ATR) are the
// scanner's. STUDY / VISUALISATION TOOL -- not a strategy.
// =====================================================================
indicator("V5 Confluence + Two-Zone DRS Gate [Study]", overlay = true,
     max_lines_count = 500, max_labels_count = 500)

// ---------------- Inputs: DRS zones ----------------
gDRS      = "DRS support/resistance"
emaFastLen= input.int(9,    "DRS EMA fast", minval = 1, group = gDRS)
emaSlowLen= input.int(21,   "DRS EMA slow", minval = 1, group = gDRS)
extLen    = input.int(3,    "Extreme lookback (3-bar low/high)", minval = 1, group = gDRS)
drsAtrLen = input.int(20,   "DRS ATR length", minval = 1, group = gDRS)
stopMult  = input.float(1.5,"DRS stop (ATR x) = the red level", step = 0.1, group = gDRS)
volLen    = input.int(14,   "Volume MA length", minval = 1, group = gDRS)
volMult   = input.float(1.8,"Volume spike (x avg)", step = 0.1, group = gDRS)
momMult   = input.float(0.3,"ATR-momentum bar (ATR x)", step = 0.1, group = gDRS)
drawZones = input.bool(true,"Draw zone lines (recent)", group = gDRS)
markDRS   = input.bool(true,"Mark every DRS bar (full history)", group = gDRS)

// ---------------- Inputs: two-zone gate ----------------
gZ        = "Two-zone gate"
zoneDays  = input.int(30,   "Zone lookback (days)", minval = 1, group = gZ)
nearBuf   = input.float(0.5,"Near-edge buffer (ATR14 x)", step = 0.1, group = gZ)
mergeMult = input.float(0.75,"Distinct-level merge (ATR14 x)", step = 0.05, group = gZ)
minZones  = input.int(2,    "Zones required for the validated tier", minval = 1, group = gZ)
useHTF    = input.bool(false,"Also count ONE higher timeframe's DRS zones", group = gZ)
htf       = input.timeframe("240","Higher timeframe", group = gZ)

// ---------------- Inputs: V5 divergence ----------------
gV5       = "V5 divergence trigger"
leftBars  = input.int(2,   "Pivot LEFT",  minval = 1, group = gV5)
rightBars = input.int(2,   "Pivot RIGHT", minval = 1, group = gV5)
fastLen   = input.int(12,  "MACD fast",   group = gV5)
slowLen   = input.int(26,  "MACD slow",   group = gV5)
sigLen    = input.int(9,   "MACD signal", group = gV5)
trendLen  = input.int(200, "Trend SMA",   minval = 20, group = gV5)
spanMin   = input.int(6,   "Span MIN (bars)", group = gV5)
spanMax   = input.int(50,  "Span MAX (bars)", group = gV5)
divAtrLen = input.int(14,  "Trade ATR length (SL/TP + buffer)", group = gV5)
slMult    = input.float(1.5,"SL (ATR x)", step = 0.1, group = gV5)
tpMult    = input.float(4.0,"TP (ATR x)", step = 0.1, group = gV5)
drawDiv   = input.bool(true,"Draw divergence lines", group = gV5)

gD        = "Display"
showWeak  = input.bool(true,"Show 1-zone (weak) confluence too", group = gD)
showLabels= input.bool(true,"Detailed label on validated (>= min) signals", group = gD)
showDash  = input.bool(true,"Show dashboard", group = gD)

windowMs = zoneDays * 86400000

// ---------------- Core series ----------------
atrDrs = ta.atr(drsAtrLen)
atrDiv = ta.atr(divAtrLen)
sma    = ta.sma(close, trendLen)
inUp   = close > sma
inDn   = close < sma

// ---------------- DRS long/short signals (faithful to drs_signals) ----------------
fe = ta.ema(close, emaFastLen)
se = ta.ema(close, emaSlowLen)
emaBull = ta.crossover(fe, se)
emaBear = ta.crossunder(fe, se)
bullExt = low  <= ta.lowest(low,  extLen)     // current bar makes the 3-bar low
bearExt = high >= ta.highest(high, extLen)    // current bar makes the 3-bar high
volOk   = na(volume) or volume == 0 ? true : volume > ta.sma(volume, volLen) * volMult
atrBull = close > close[1] + atrDrs * momMult
atrBear = close < close[1] - atrDrs * momMult
drsLong  = emaBull and bullExt and volOk and atrBull
drsShort = emaBear and bearExt and volOk and atrBear
longRed  = low  - stopMult * atrDrs            // support level (the red)
shortRed = high + stopMult * atrDrs            // resistance level (the red)

// ---------------- Function defs (must precede use) ----------------
// prune oldest entries (front) beyond the lookback window; arrays mutated in place
prune(arrT, arrL) =>
    while array.size(arrT) > 0 and (time - array.get(arrT, 0)) > windowMs
        array.shift(arrT)
        array.shift(arrL)

// count DISTINCT levels (merged within mergeMult*ATR14) near `entryP` within the
// window at `refT`. Optionally folds in a second (HTF) pair of arrays.
f_count(arrT, arrL, arrT2, arrL2, refT, entryP, atrv, isLong) =>
    tmp = array.new<float>()
    if array.size(arrL) > 0
        for i = 0 to array.size(arrL) - 1
            t  = array.get(arrT, i)
            lv = array.get(arrL, i)
            dt = refT - t
            near = isLong ? (entryP <= lv + nearBuf * atrv) : (entryP >= lv - nearBuf * atrv)
            if dt >= 0 and dt <= windowMs and near
                array.push(tmp, lv)
    if useHTF and array.size(arrL2) > 0
        for i = 0 to array.size(arrL2) - 1
            t  = array.get(arrT2, i)
            lv = array.get(arrL2, i)
            dt = refT - t
            near = isLong ? (entryP <= lv + nearBuf * atrv) : (entryP >= lv - nearBuf * atrv)
            if dt >= 0 and dt <= windowMs and near
                array.push(tmp, lv)
    cnt = 0
    if array.size(tmp) > 0
        array.sort(tmp, order.ascending)
        tol = mergeMult * atrv
        float prev = na
        for i = 0 to array.size(tmp) - 1
            v = array.get(tmp, i)
            if na(prev) or (v - prev) > tol
                cnt := cnt + 1
                prev := v
    cnt

// ---------------- Zone stores (chart TF), pruned to the window ----------------
var arrLT = array.new<int>()      // long-zone (support) times, ms
var arrLL = array.new<float>()    // long-zone levels
var arrST = array.new<int>()      // short-zone (resistance) times
var arrSL = array.new<float>()    // short-zone levels
if drsLong and not na(atrDrs)
    array.push(arrLT, time)
    array.push(arrLL, longRed)
if drsShort and not na(atrDrs)
    array.push(arrST, time)
    array.push(arrSL, shortRed)
prune(arrLT, arrLL)
prune(arrST, arrSL)

// ---------------- Optional: one higher timeframe's DRS zones ----------------
f_htf_drs() =>
    hfe = ta.ema(close, emaFastLen)
    hse = ta.ema(close, emaSlowLen)
    hvol = na(volume) or volume == 0 ? true : volume > ta.sma(volume, volLen) * volMult
    ha  = ta.atr(drsAtrLen)
    hL  = ta.crossover(hfe, hse) and (low <= ta.lowest(low, extLen)) and hvol and (close > close[1] + ha * momMult)
    hS  = ta.crossunder(hfe, hse) and (high >= ta.highest(high, extLen)) and hvol and (close < close[1] - ha * momMult)
    [hL, low - stopMult * ha, hS, high + stopMult * ha, time]
[htfLong, htfLongRed, htfShort, htfShortRed, htfTime] = request.security(syminfo.tickerid, htf, f_htf_drs(), barmerge.gaps_off, barmerge.lookahead_off)
var arrHLT = array.new<int>()
var arrHLL = array.new<float>()
var arrHST = array.new<int>()
var arrHSL = array.new<float>()
if useHTF
    if htfLong and htfTime != htfTime[1] and not na(htfLongRed)
        array.push(arrHLT, htfTime)
        array.push(arrHLL, htfLongRed)
    if htfShort and htfTime != htfTime[1] and not na(htfShortRed)
        array.push(arrHST, htfTime)
        array.push(arrHSL, htfShortRed)
    prune(arrHLT, arrHLL)
    prune(arrHST, arrHSL)

// ---------------- V5 aligned divergence detection ----------------
[macdLine, _s, _h] = ta.macd(close, fastLen, slowLen, sigLen)
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low,  leftBars, rightBars)

var float lastPHp = na
var float lastPHm = na
var int   lastPHb = na
var float lastPLp = na
var float lastPLm = na
var int   lastPLb = na
bool bearSig = false
bool bullSig = false

if not na(ph)
    m = macdLine[rightBars]
    b = bar_index - rightBars
    if not na(lastPHp)
        span = b - lastPHb
        if ph > lastPHp and m < lastPHm and span >= spanMin and span <= spanMax and inDn
            bearSig := true
            if drawDiv
                line.new(lastPHb, lastPHp, b, ph, color = color.new(#dc2626, 0), width = 2)
    lastPHp := ph
    lastPHm := m
    lastPHb := b

if not na(pl)
    m = macdLine[rightBars]
    b = bar_index - rightBars
    if not na(lastPLp)
        span = b - lastPLb
        if pl < lastPLp and m > lastPLm and span >= spanMin and span <= spanMax and inUp
            bullSig := true
            if drawDiv
                line.new(lastPLb, lastPLp, b, pl, color = color.new(#16a34a, 0), width = 2)
    lastPLp := pl
    lastPLm := m
    lastPLb := b

// evaluate the gate at the confirming pivot bar (matches scanner semantics)
refT    = time[rightBars]
entryL  = close[rightBars]
atrDivR = atrDiv[rightBars]
cntL = bullSig ? f_count(arrLT, arrLL, arrHLT, arrHLL, refT, entryL, atrDivR, true)  : 0
cntS = bearSig ? f_count(arrST, arrSL, arrHST, arrHSL, refT, entryL, atrDivR, false) : 0

// ---------------- Tier booleans (uncapped plotshape, full history) ----------------
buy1 = bullSig and cntL == 1
buy2 = bullSig and cntL == 2
buy3 = bullSig and cntL >= 3
sel1 = bearSig and cntS == 1
sel2 = bearSig and cntS == 2
sel3 = bearSig and cntS >= 3

// ---------------- Draw DRS zones + markers ----------------
barsWin = math.max(1, math.round(windowMs / (timeframe.in_seconds() * 1000)))
if drawZones and drsLong
    line.new(bar_index, longRed, bar_index + int(barsWin), longRed, color = color.new(#dc2626, 35), width = 1, style = line.style_dashed)
if drawZones and drsShort
    line.new(bar_index, shortRed, bar_index + int(barsWin), shortRed, color = color.new(#16a34a, 35), width = 1, style = line.style_dashed)
plotshape(markDRS and drsLong,  "DRS support",    shape.xcross, location.belowbar, color = color.new(#dc2626, 20), size = size.tiny)
plotshape(markDRS and drsShort, "DRS resistance", shape.xcross, location.abovebar, color = color.new(#16a34a, 20), size = size.tiny)

// ---------------- Draw confluence tiers ----------------
plotshape(showWeak and buy1, "Buy 1 zone",  shape.triangleup, location.belowbar, color = color.new(#16a34a, 60), size = size.tiny,   offset = -rightBars, text = "◆")
plotshape(buy2,              "Buy 2 zones", shape.triangleup, location.belowbar, color = color.new(#16a34a, 0),  size = size.small,  offset = -rightBars, text = "◆◆")
plotshape(buy3,              "Buy 3+ zones",shape.triangleup, location.belowbar, color = color.new(#15803d, 0),  size = size.normal, offset = -rightBars, text = "◆◆◆")
plotshape(showWeak and sel1, "Sell 1 zone", shape.triangledown, location.abovebar, color = color.new(#dc2626, 60), size = size.tiny,   offset = -rightBars, text = "◆")
plotshape(sel2,              "Sell 2 zones",shape.triangledown, location.abovebar, color = color.new(#dc2626, 0),  size = size.small,  offset = -rightBars, text = "◆◆")
plotshape(sel3,              "Sell 3+ zones",shape.triangledown,location.abovebar, color = color.new(#b91c1c, 0),  size = size.normal, offset = -rightBars, text = "◆◆◆")

// ---------------- Detailed labels on validated (>= minZones) signals ----------------
f_label(isLong, cnt) =>
    e  = close[rightBars]
    sl = isLong ? e - slMult * atrDivR : e + slMult * atrDivR
    tp = isLong ? e + tpMult * atrDivR : e - tpMult * atrDivR
    txt = (isLong ? "BUY  " : "SELL  ") + str.tostring(cnt) + " zones\n" + "entry " + str.tostring(e, format.mintick) + "\n" + "SL " + str.tostring(sl, format.mintick) + "  TP " + str.tostring(tp, format.mintick)
    label.new(bar_index - rightBars, isLong ? low[rightBars] : high[rightBars], txt, style = isLong ? label.style_label_up : label.style_label_down, color = color.new(isLong ? #16a34a : #dc2626, 10), textcolor = color.white, size = size.small)
if showLabels and bullSig and cntL >= minZones
    f_label(true, cntL)
if showLabels and bearSig and cntS >= minZones
    f_label(false, cntS)

// ---------------- Live gate state (current bar, at price) ----------------
nowL = f_count(arrLT, arrLL, arrHLT, arrHLL, time, close, atrDiv, true)
nowS = f_count(arrST, arrSL, arrHST, arrHSL, time, close, atrDiv, false)

// ---------------- Dashboard ----------------
if showDash and barstate.islast
    var table t = table.new(position.top_right, 2, 6, border_width = 1, bgcolor = color.new(#0a0e1a, 10), frame_color = color.new(color.blue, 60), frame_width = 1)
    table.cell(t, 0, 0, "CONFLUENCE 2-ZONE", text_color = color.aqua, text_size = size.small, bgcolor = color.new(#0d1424, 0))
    table.cell(t, 1, 0, syminfo.ticker + " " + timeframe.period, text_color = color.gray, text_size = size.small, bgcolor = color.new(#0d1424, 0))
    table.cell(t, 0, 1, "Trend (200-SMA)", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 1, inUp ? "UP" : inDn ? "DOWN" : "flat", text_color = inUp ? color.new(#16a34a, 0) : color.new(#dc2626, 0), text_size = size.small)
    table.cell(t, 0, 2, "Near support zones", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 2, str.tostring(nowL) + (nowL >= minZones ? "  OK" : ""), text_color = nowL >= minZones ? color.new(#16a34a, 0) : color.gray, text_size = size.small)
    table.cell(t, 0, 3, "Near resistance zones", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 3, str.tostring(nowS) + (nowS >= minZones ? "  OK" : ""), text_color = nowS >= minZones ? color.new(#dc2626, 0) : color.gray, text_size = size.small)
    table.cell(t, 0, 4, "Support zones in " + str.tostring(zoneDays) + "d", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 4, str.tostring(array.size(arrLL)), text_color = color.gray, text_size = size.small)
    table.cell(t, 0, 5, "Resistance zones in " + str.tostring(zoneDays) + "d", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 5, str.tostring(array.size(arrSL)), text_color = color.gray, text_size = size.small)

// ---------------- Data-window counters ----------------
plotchar(cntL, "Buy zone count",  "", location.top, color = color.new(#16a34a, 0), size = size.tiny)
plotchar(cntS, "Sell zone count", "", location.top, color = color.new(#dc2626, 0), size = size.tiny)

// ---------------- Alerts ----------------
alertcondition(bullSig and cntL >= minZones, "Confluence BUY (>= min zones)",  "Two-zone confluence BUY on {{ticker}} @ {{close}}")
alertcondition(bearSig and cntS >= minZones, "Confluence SELL (>= min zones)", "Two-zone confluence SELL on {{ticker}} @ {{close}}")
